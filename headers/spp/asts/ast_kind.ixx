namespace spp::asts {
  /**
   * The block of kinds that are a @p T . Unspecialised for anything outside the ast tree - the mixins, which are
   * cross-casts rather than downcasts - and @c Ast::To() falls back to @c dynamic_cast for those.
   */
  SPP_EXP_CLS template <typename T>
  struct AstKindRange {
    static constexpr auto Known = false;
  };

  template <>
  struct AstKindRange<AnnotationAst> {
    static constexpr auto Known = true;
    static constexpr auto First = AstKind::kAnnotationAst;
    static constexpr auto Last = AstKind::kAnnotationAst;
