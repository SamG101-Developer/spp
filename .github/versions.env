# Single place to record the pinned toolchain versions and digests. Loaded into the job environment (GITHUB_ENV) by the
# "Load pinned versions" step at the top of setup-toolchain, run-tests and the docs workflow; lines not of the form
# NAME=value are ignored, and names not on the allowlist in load-versions.sh are rejected.

# The test runner, fetched from GitHub and then executed by
# python3 against the built test binary, so it is pinned by
# commit.
GTEST_PARALLEL_COMMIT=cd488bdedc1d2cffb98201a17afc1b298b0b90f1

# The dependency scanner. Pinned by release rather than
# fetched from `releases/latest`, which is a moving pointer,
# and verified before it is put on PATH: a scanner that
# runs on every push is a poor thing to take on trust.
OSV_SCANNER_VERSION=2.5.0
OSV_SCANNER_SHA256=edcfc41d257db36148f065055655fe3fcfc434b0b423ea67468a84c207524e0c

# The secret scanner. Pinned and verified for the same
# reason as the scanner above: it runs on every push, and
# the pre-commit hook of the same name only ever reads the
# index, so this copy is the one that actually scans the
# repository. Keep the version in step with the gitleaks
# rev in .pre-commit-config.yaml.
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb

# The static analyser, built from source and pinned by
# commit rather than by release tarball: GitHub's generated
# archives are not byte-stable, so a sha256 over one is a
# pin that can break without anybody touching the tag. The
# distribution packages are years behind (24.04 ships 2.13)
# and cannot parse C++20 modules at all, so a source build
# is the only version that reads this codebase.
CPPCHECK_VERSION=2.21.1
CPPCHECK_COMMIT=904cfdcf774c44b17db789c8a212e2f1c69fc833

#
LLVM_LIB_VERSION=23

# apt.llvm.org's installer, fetched by fetch-llvm-sh.sh and
# then run as root by the Clang and LLVM steps.
LLVM_SH_SHA256=03878e08f47b66cc95bc4b544b0db3c6d9ce8d60e6cf2492ae357984330a9eae

# The Windows LLVM tarball, named in full because the asset
# name is not derivable from the tag: llvmorg-23.1.0-rc3
# ships it as clang+llvm-23.0.0.3-x86_64-pc-windows-msvc.tar.xz.
LLVM_WIN_TAG=llvmorg-23.1.0-rc3
LLVM_WIN_ASSET=clang+llvm-23.0.0.3-x86_64-pc-windows-msvc.tar.xz
LLVM_WIN_SHA256=9465632c6d96e65ab6b7f6fbf7ae447621803982b2348483221812bbf4c8b6af

# Boost comes prebuilt from a third-party repository
# (MarkusJx/prebuilt-boost), so it gets one digest per
# runner.
BOOST_VERSION=1.91.0
BOOST_SHA256_LINUX=24b11fd9c9287389491c16d1e22522ab7d6adaaf1fd80af1ece2436e5dd883d9
BOOST_SHA256_LINUX_ARM64=c888304ea2f244f87e28044e1be35d82236e8c118d5811892583a9e360795058
BOOST_SHA256_MACOS=3b249cddee3fde8c20427b4ff93e18c2d88b8fb3bfeb2861081e8d16923bdf85
BOOST_SHA256_WINDOWS=bf4b5ec8893a25cd5be1cda3a33f020ae925919a8ad6296b289d0787892db395

# C++ key version information for compilers and building.
GCC_VERSION=16
LIBSTDCXX_GCC_VERSION=16.2
CMAKE_VERSION=4.4.0
NINJA_VERSION=1.13.2
PYTHON_VERSION=3.14

# Doxygen key version information.
DOXYGEN_VERSION=1.17.0
DOXYGEN_SHA256=75419ef4f446fc1c24ef12514b574e66e898ee6f527c6ae2ad84f91a905823c2
