# Single place to bump cache-key versions and pinned toolchain versions. Loaded into the job environment (GITHUB_ENV) by
# the "Load pinned versions" step at the top of setup-toolchain, run-tests and the docs workflow; lines not of the form
# NAME=value are ignored.

# Cache-key versions. The dependency cache keys also carry the UTC date, so they roll over once a day on their own; bump
# these to force a rebuild sooner. Bump them too whenever an install prefix moves: a restored entry unpacks to the path
# it was saved from, so a stale hit would leave the new prefix empty while still reporting cache-hit and skipping the
# install.
SPP_LIBS_CACHE_VERSION=8
GTEST_PARALLEL_CACHE_VERSION=1
DOXYGEN_CACHE_VERSION=1

# Non-cmake library versions.
LLVM_LIB_VERSION=22
LLVM_LIB_FULL_VERSION=22.1.8
BOOST_VERSION=1.91.0

# C++ key version information for compilers and building.
LIBSTDCXX_GCC_VERSION=16
CMAKE_VERSION=4.1.2

# Doxygen key version information.
DOXYGEN_VERSION=1.17.0
DOXYGEN_SHA256=75419ef4f446fc1c24ef12514b574e66e898ee6f527c6ae2ad84f91a905823c2
