use std::console::println
use std::hints::black_box

cor inner(n: U64) -> std::iterator::Iterator[U64] {
  let mut i = 0_u64
  loop i < n {
    gen i
    i += 1_u64
  }
}

cor outer(n: U64) -> std::iterator::Iterator[U64] {
  gen with inner(n)
}

fun main() -> Void {
  let n = black_box(50000000_u64)
  let mut sum = 0_u64
  loop x in outer(n) {
    sum = (sum + x * 5_u64) % 1000000007_u64
  }
  let mut g = inner(n)
  let mut count = 0_u64
  let mut running = true
  loop running {
    case g.res() of {
      is std::generator::GenDone() { running = false }
      else { count += 1_u64 }
    }
  }
  drop(g)
  println("{}\n{}", sum, count)
}
