use std::console::println
use std::hints::black_box

fun mix(acc: &mut U64, i: U64) -> Void {
  acc@ = acc@ ^ (i & 255_u64)
}

fun main() -> Void {
  let n = black_box(100000000_u64)
  let mut acc = 0_u64
  let mut i = 0_u64
  loop i < n {
    {
      defer mix(&mut acc, i)
      acc = (acc * 3_u64 + i) % 1000003_u64
    }
    i += 1_u64
  }
  println("{}", acc)
}
