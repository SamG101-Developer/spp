use std::console::println
use std::hints::black_box

fun main() -> Void {
  let n = black_box(100000000_u64)
  let k = black_box(17_u64)
  let step = (x: U64 caps &k) -> U64 { ret (x * k@ + 1_u64) % 1000003_u64 }
  let mut acc = black_box(5_u64)
  let mut i = 0_u64
  loop i < n {
    acc = step(acc)
    i += 1_u64
  }
  println("{}", acc)
}
