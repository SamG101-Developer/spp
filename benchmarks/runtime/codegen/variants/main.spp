use std::console::println
use std::hints::black_box

fun find(x: U64) -> Opt[U64] {
  case x % 5_u64 == 0_u64 { ret None }
  ret Some(val=x * 2_u64)
}

fun main() -> Void {
  let n = black_box(100000000_u64)
  let mut acc = 0_u64
  let mut i = 0_u64
  loop i < n {
    let found: Opt[U64] = find(i)
    case found of {
      is Some[U64](val) { acc = (acc + val) % 1000000007_u64 }
      else { acc += 1_u64 }
    }
    i += 1_u64
  }
  println("{}", acc)
}
