use std::console::println
use std::hints::black_box

fun main() -> Void {
  let n = black_box(4096_uz)
  let passes = black_box(50000_s64)
  let mut state = black_box(12345_u64)
  let mut i = 0_uz
  let mut a = Vec[S64]::new_with_capacity(n)
  i = 0_uz
  loop i < n {
    state = state.mul_wrapping(6364136223846793005_u64).add_wrapping(1442695040888963407_u64)
    a.append(S64::from(state >> 44_u32))
    i += 1_uz
  }
  let mut b = Vec[S64]::new_with_capacity(n)
  i = 0_uz
  loop i < n {
    state = state.mul_wrapping(6364136223846793005_u64).add_wrapping(1442695040888963407_u64)
    b.append(S64::from(state >> 44_u32))
    i += 1_uz
  }
  let mut sum = 0_s64
  let mut pass = 0_s64
  loop pass < passes {
    let mut dot = 0_s64
    i = 0_uz
    loop i < n {
      dot = dot + a[i]@ * b[i]@
      i += 1_uz
    }
    sum = (sum + dot % 1000003_s64 + pass) % 1000000007_s64
    pass += 1_s64
  }
  println("{}", sum)
  drop(a)
  drop(b)
}
